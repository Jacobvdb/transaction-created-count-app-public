{
    "name": "transaction-created-count-app",
    "private": true,
    "scripts": {
        "clean": "rm -rf node_modules server/node_modules dist",
        "predev": "bun install",
        "dev": "concurrently \"vite dev\" \"bkper app dev\"",
        "dev:client": "vite dev",
        "dev:server": "bkper app dev",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "check": "bun run typecheck && bun test",
        "prebuild": "bun install",
        "build": "vite build && bkper app build",
        "deploy": "bun run build && bkper app sync && bkper app deploy",
        "deploy:preview": "bun run build && bkper app sync && bkper app deploy --preview"
    },
    "devDependencies": {
        "@bkper/bkper-api-types": "latest",
        "bkper": "^4.16.0",
        "@cloudflare/workers-types": "^4.20260608.1",
        "concurrently": "^9",
        "miniflare": "^4.20260603.0",
        "prettier": "^3",
        "typescript": "^5",
        "vite": "^7.3.5"
    },
    "dependencies": {
        "@bkper/web-auth": "latest",
        "bkper-js": "latest",
        "hono": "^4.12.24"
    },
    "overrides": {
        "brace-expansion": "^5.0.6",
        "protobufjs": "^8.6.1",
        "ws": "^8.21.0"
    }
}
